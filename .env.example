# Copy to .env. Environment variables take precedence over this file.
# Set 0 to force local mode even if DEEPSEEK_API_KEY exists in PowerShell.
DEEPSEEK_ENABLED=1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional path for the shared local LangGraph SQLite checkpoint.
# Defaults to .runtime/quote_checkpoints.sqlite3 beside the project.
QUOTE_DB_PATH=

# Accepts a Hugging Face model ID or a local directory.
BGE_MODEL=BAAI/bge-small-zh-v1.5
# Alternative: BAAI/bge-m3
RAG_ALLOW_MODEL_DOWNLOAD=0
BGE_RERANKER_MODEL=
# Optional: BAAI/bge-reranker-base
RAG_DENSE_MIN_SIMILARITY=0.60
RAG_CHROMA_DIR=

MACBERT_MODEL_DIR=.runtime/macbert
